NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=elearning_db

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB (default for images)
UPLOAD_DIR=./src/uploads

# File size limits (in bytes)
MAX_IMAGE_SIZE=10485760     # 10MB
MAX_VIDEO_SIZE=524288000    # 500MB
MAX_DOCUMENT_SIZE=52428800  # 50MB
MAX_AUDIO_SIZE=104857600    # 100MB

# File processing options
ENABLE_IMAGE_OPTIMIZATION=true
ENABLE_VIDEO_PROCESSING=false
IMAGE_QUALITY=85
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1080

# Bulk upload settings
MAX_BULK_FILES=10
ENABLE_BULK_UPLOAD=true

# File access settings
ENABLE_DIRECT_ACCESS=true
ENABLE_DOWNLOAD_LOGGING=false

# JWT Configuration
JWT_SECRET=tasin_secure_key_12345
JWT_EXPIRES_IN=1d

# SSL Commerz Configuration (Sandbox)
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=http://localhost:5000/api/payment/ssl/success
SSLCOMMERZ_FAIL_URL=http://localhost:5000/api/payment/ssl/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:5000/api/payment/ssl/cancel
SSLCOMMERZ_IPN_URL=http://localhost:5000/api/payment/ssl/ipn

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Future Cloud Storage Configuration (for later use)
# AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET_NAME=

# Google Cloud Storage  
# GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_CLOUD_KEY_FILE=
# GCS_BUCKET_NAME=

# Cloudflare R2
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_KEY_ID=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_BUCKET_NAME=

# Bunny CDN
# BUNNY_ACCESS_KEY=
# BUNNY_STORAGE_ZONE=
# BUNNY_STORAGE_PASSWORD=
# BUNNY_HOSTNAME=

# Development Settings
DEBUG_FILE_UPLOAD=true
LOG_FILE_ACCESS=true
ENABLE_FILE_CLEANUP=false